{
  "body": {
    "backgroundColor": "rgba(0, 0, 0, 0)",
    "color": "rgb(247, 251, 255)"
  },
  "grid": {
    "columns": "minmax(0px, 1.2fr) minmax(320px, 0.68fr)",
    "areas": "\"material poll\" \"caption caption\" \"recap recap\" \"voices summary\" \"composer summary\" \"exit exit\""
  },
  "mode": "mobile",
  "overflowFree": true,
  "sections": [
    {
      "display": "block",
      "gridArea": "material",
      "selector": "#lecture-material"
    },
    {
      "display": "block",
      "gridArea": "caption",
      "selector": "#lecture-caption"
    },
    {
      "display": "grid",
      "gridArea": "voices",
      "selector": "#lecture-voices"
    },
    {
      "display": "block",
      "gridArea": "auto",
      "selector": "#lecture-question"
    },
    {
      "display": "block",
      "gridArea": "poll",
      "selector": "#lecture-poll"
    },
    {
      "display": "block",
      "gridArea": "recap",
      "selector": ".lecture-area-recap"
    },
    {
      "display": "block",
      "gridArea": "summary",
      "selector": ".lecture-area-summary"
    },
    {
      "display": "flex",
      "gridArea": "exit",
      "selector": ".lecture-area-exit"
    }
  ]
}
