{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "compass-private-pdf-assets",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-14",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://compass-interactive.pages.dev",
    "PDF_ACCESS_AUDIENCE": "compass-pdf-worker",
    "PDF_ACCESS_ISSUER": "compass-supabase",
    "TURNSTILE_EXPECTED_HOSTNAME": "compass-interactive.pages.dev",
  },
  "triggers": {
    "crons": ["*/30 * * * *"],
  },
  "r2_buckets": [
    {
      "binding": "PDF_BUCKET",
      "bucket_name": "compass-private-pdf-assets",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ARCHIVE_FAILURE_GUARD",
        "class_name": "ArchiveFailureGuard",
      },
    ],
  },
  "migrations": [
    {
      "tag": "phase6-6-archive-failure-guard-v1",
      "new_sqlite_classes": ["ArchiveFailureGuard"],
    },
  ],
  "ratelimits": [
    {
      "name": "ARCHIVE_IP_RATE_LIMITER",
      "namespace_id": "6602",
      "simple": {
        "limit": 600,
        "period": 60,
      },
    },
    {
      "name": "ARCHIVE_RATE_LIMITER",
      "namespace_id": "6601",
      "simple": {
        "limit": 12,
        "period": 60,
      },
    },
  ],
  "secrets": {
    "required": [
      "ARCHIVE_ACCESS_SECRET",
      "ARCHIVE_CODE_LOOKUP_SECRET",
      "ARCHIVE_INGEST_SECRET",
      "PDF_ACCESS_PUBLIC_JWK",
      "PDF_ASSET_TICKET_SECRET",
      "PDF_RETENTION_SYNC_SECRET",
      "PDF_RETENTION_FEED_URL",
      "TURNSTILE_SECRET_KEY",
    ],
  },
}
