{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "compass-presenter-gateway-production",
  "account_id": "f60a242ad3132b1a7ba11839c23d76f7",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "presenter-api.yuto-matsui.com",
      "custom_domain": true,
      "zone_id": "68e9bb3faf02379bfcce2ee019e28326",
    },
  ],
  "ratelimits": [
    {
      "name": "PRESENTER_LOCATION_RATE_LIMITER",
      "namespace_id": "72931",
      "simple": { "limit": 9000, "period": 60 },
    },
    {
      "name": "PRESENTER_NETWORK_RATE_LIMITER",
      "namespace_id": "72932",
      "simple": { "limit": 1200, "period": 60 },
    },
  ],
  "secrets": {
    "required": ["PRESENTER_BRIDGE_GATEWAY_SECRET"],
  },
}
