# Copy this file to .env.local and fill in local development values.
# .env.local must never be committed.
# Do not put real secrets in this example file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Public Cloudflare Turnstile site key. Never put the secret key in VITE_*.
VITE_TURNSTILE_SITE_KEY=your-public-site-key
VITE_DEV_LECTURE_SESSION_ID=
# Phase 1 is expand-first. Keep false until its migration has passed production checks.
VITE_PHASE1_SYNC_PROTOCOL=false

# Future server-side / Supabase Edge Function only.
# Never expose this as VITE_OPENAI_API_KEY.
OPENAI_API_KEY=
