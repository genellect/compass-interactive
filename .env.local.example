# Copy this file to .env.local and fill in local development values.
# .env.local must never be committed.
# Do not put real secrets in this example file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Public Cloudflare Turnstile site key. Never put the secret key in VITE_*.
VITE_TURNSTILE_SITE_KEY=your-public-site-key
VITE_DEV_LECTURE_SESSION_ID=
# Phase 1 is expand-first. Keep false until its migration has passed production checks.
VITE_PHASE1_SYNC_PROTOCOL=false
# Phase 2 archive/lifecycle UX is expand-first and remains OFF through Phase 6.
VITE_PHASE2_LECTURE_LIFECYCLE=false
# Phase 3 private PDF delivery remains OFF until Worker/R2/Edge rollout passes.
VITE_PHASE3_PRIVATE_PDF=false
# Phase 7.26 browser-complete PDF publishing remains OFF until the matching
# Edge, Worker, database and hosted CPU gates have passed.
VITE_PHASE7_26_BROWSER_PDF_PUBLISHING=false
# Phase 7.27 Journal Club preset remains OFF until its database, Worker,
# browser and human rehearsal gates have passed.
VITE_PHASE7_27_JOURNAL_CLUB=false
# Phase 7.28 retires the one-off preset creation card by default while keeping
# existing Journal Club history and archive rendering compatible.
VITE_PHASE7_28_JOURNAL_CLUB_PRESET_CREATION=false
# Private Realtime is an optional acceleration path for one claimed classroom
# Display. Students continue to use the five-second snapshot protocol.
VITE_PHASE7_28_DISPLAY_REALTIME=false
# Phase 7.28 lecture-scoped AI authorization remains OFF until its RLS,
# two-Admin, cost-ledger and browser gates pass.
VITE_PHASE7_28_AI_MASTER_AUTH=false
# Phase 7.29 PowerPoint synchronization is a Windows Presenter Bridge preview.
# It remains OFF until the native, HTTPS-to-loopback and hosted gates pass.
VITE_PHASE7_29_POWERPOINT_SYNC=false
# Phase 7.30 B1 adds a separate Google + TOTP Admin identity preview. It stays
# OFF until local identity-isolation gates and a separately authorized Hosted
# OAuth/TOTP canary pass. Legacy PIN remains available during expand-first.
VITE_PHASE7_30_ADMIN_IDENTITY=false
VITE_PHASE7_30_LEGACY_ADMIN_PIN=true
VITE_PHASE7_30_ADMIN_AI_UNLOCK=false
VITE_PHASE7_30_ADMIN_TOTP_FACTOR_MUTATION=false
VITE_PHASE7_30_GOOGLE_ADMIN_OPERATIONS=false
VITE_PHASE7_30_GOOGLE_ADMIN_LEDGER=false
# Phase 4 billing gate and Realtime captions remain OFF until the Phase 6 rollout.
VITE_PHASE4_REALTIME_CAPTIONS=false
# Phase 5 PDF analysis and AI Poll drafts remain OFF until the Phase 6 rollout.
VITE_PHASE5_MATERIAL_ANALYSIS=false
# Phase 6 five-minute summaries remain OFF until the combined production gate.
VITE_PHASE6_SUMMARIES=false
# Phase 6.5 optional comment nicknames remain OFF for live Supabase lectures.
VITE_PHASE6_5_COMMENT_NICKNAMES=false
# Phase 6.6 snapshot metrics and R2 archive lookup remain OFF until the
# expand migration, Worker and Edge exporter are all deployed.
VITE_PHASE6_6_UX_INTEGRATION=false
# Phase 6.8 tracked Admin sessions and lecture resume tokens remain OFF until
# their migration, Edge Functions, Worker secret and CSP gate all pass.
VITE_PHASE6_8_SECURITY=false
# Phase 7.1 summary language, own-comment history and local QR remain OFF until
# the expand migration and all classroom browser gates pass.
VITE_PHASE7_1_CLASSROOM_EXTENSIONS=false
# Phase 7.2 verified-literature reference answers remain OFF until the
# literature quality, human review and hosted gates pass.
VITE_PHASE7_2_ACADEMIC_ANSWERS=false
# Phase 7.25 automatic answers require the Phase 7.2 UI and remain separately OFF.
VITE_PHASE7_25_AUTO_ACADEMIC_ANSWERS=false
VITE_PDF_PUBLISHER_URL=http://127.0.0.1:43123
VITE_PDF_WORKER_BASE_URL=

# Supabase Edge Function only. The Admin session secret must be independent
# from both PINs and contain at least 32 bytes.
ADMIN_PIN=
ADMIN_SESSION_SECRET=
PHASE730_ADMIN_IDENTITY_ENABLED=false
PHASE730_LEGACY_ADMIN_PIN_ENABLED=true
PHASE730_ADMIN_ENVIRONMENT_ID=
# Separate server-only HMAC pepper for Google subject/email admission digests.
# Never expose this as VITE_* and do not reuse the Admin session secret.
ADMIN_IDENTITY_PEPPER=
ADMIN_IDENTITY_PEPPER_VERSION=1
# Phase 7.30B2.2b source gates. Keep both false until the database gates,
# Hosted Edge secrets and Human browser-profile evidence are approved.
PHASE730_ADMIN_AI_UNLOCK_ENABLED=false
PHASE730_ADMIN_TOTP_FACTOR_MUTATION_ENABLED=false
# Phase 7.30C2 operational transport stays source-OFF until every Edge action
# is backed by a same-transaction Google Admin database facade.
PHASE730_GOOGLE_ADMIN_OPERATIONS_ENABLED=false
PHASE730_GOOGLE_ADMIN_LEDGER_ENABLED=false
ADMIN_INVITATION_SECRET=
# Independent server-only secrets. Generate at least 32 random bytes for each;
# never expose them as VITE_*, logs, browser storage or audit metadata.
ADMIN_AI_PIN_PEPPER=
ADMIN_AI_PIN_PEPPER_VERSION=1
ADMIN_AI_NETWORK_PEPPER=
ADMIN_AI_BROWSER_CHALLENGE_SECRET=
# C2 derives one retry-stable, two-minute child nonce per provider attempt.
# Rotate by increasing the version; never reuse an Admin or provider API key.
ADMIN_AI_CHILD_GRANT_SECRET=
ADMIN_AI_CHILD_GRANT_SECRET_VERSION=1
# Optional local Google provider values. A clean checkout keeps the provider
# disabled; real values remain in an untracked developer environment.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
PHASE68_TRACKED_ADMIN_SESSIONS_ENABLED=false
PHASE68_RESUME_TOKENS_ENABLED=false
LECTURE_RESUME_TOKEN_SECRET=
COMPASS_EDGE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# OpenAI / paid-feature server settings. Never expose these with VITE_*.
# Never expose this as VITE_OPENAI_API_KEY.
OPENAI_API_KEY=
# Must be different from ADMIN_PIN. Keep it server-side and out of browser storage.
BILLING_PIN=
PHASE4_REALTIME_CAPTIONS_ENABLED=false
REALTIME_SWEEP_TRIGGER_SECRET=
PHASE5_MATERIAL_ANALYSIS_ENABLED=false
PHASE6_SUMMARIES_ENABLED=false
PHASE7_1_CLASSROOM_EXTENSIONS_ENABLED=false
PHASE7_2_ACADEMIC_ANSWERS_ENABLED=false
PHASE7_25_AUTO_ACADEMIC_ANSWERS_ENABLED=false
# Phase 7.26 Edge orchestration remains OFF until the Worker route and database
# migrations have passed their hosted gates. JWK and coordinator values are
# server-only and must match the Worker configuration. Enabling this flag
# rejects every Local Publisher registration; stop Local Publisher and revoke
# or isolate its R2 write credential before changing it to true.
PHASE726_BROWSER_PDF_PUBLICATION_ENABLED=false
# Server-side admission for the one production run and repeatable rehearsals.
PHASE7_27_JOURNAL_CLUB_ENABLED=false
# Phase 7.28 retires new Journal Club preset creation without disabling the
# existing Phase 7.27 history and permanent archive contract. Enable only for
# an explicitly approved recovery exercise; missing values fail closed.
PHASE7_28_JOURNAL_CLUB_PRESET_CREATION_ENABLED=false
# Server-side Display binding and Realtime admission. Missing values fail
# closed; deploy the additive migration and claim function before enabling.
PHASE728_DISPLAY_REALTIME_ENABLED=false
# Server-side admission for lecture-scoped AI authorization. This never stores
# the PIN or starts provider work; every action still consumes a child grant.
PHASE7_28_AI_MASTER_AUTH_ENABLED=false
# Server admission and dedicated secrets for PowerPoint Presenter Bridge.
# The gateway secret authenticates only the dedicated Cloudflare gateway to
# the machine Edge endpoint. Generate separate random values of at least 32
# bytes; never expose either value as VITE_* or to the native Bridge.
PHASE729_POWERPOINT_SYNC_ENABLED=false
PRESENTER_BRIDGE_TOKEN_SECRET=
PRESENTER_BRIDGE_GATEWAY_SECRET=
PDF_PUBLICATION_WORKER_BASE_URL=
PDF_PUBLICATION_COORDINATOR_SECRET=
PDF_PUBLICATION_PRIVATE_JWK=
# Server-only contact required by NCBI/Crossref polite API usage.
LITERATURE_API_CONTACT_EMAIL=
PHASE6_6_ARCHIVE_EXPORT_ENABLED=false
ARCHIVE_EXPORT_TRIGGER_SECRET=
ARCHIVE_WORKER_INGEST_URL=
ARCHIVE_INGEST_SECRET=
DAILY_DIGEST_ENABLED=false
DAILY_DIGEST_TRIGGER_SECRET=
DAILY_DIGEST_RECIPIENT=matsui.yuto@st.kitasato-u.ac.jp
DAILY_DIGEST_FROM=
DAILY_DIGEST_REPLY_TO=matsui.yuto@st.kitasato-u.ac.jp
RESEND_API_KEY=
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
# $0.017 per audio minute = 17,000 micro-USD as of 2026-07-15.
OPENAI_REALTIME_PRICE_MICROUSD_PER_MINUTE=17000
