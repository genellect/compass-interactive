# Copy this file to .env.local and fill in local development values.
# .env.local must never be committed.
# Do not put real secrets in this example file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Public Cloudflare Turnstile site key. Never put the secret key in VITE_*.
VITE_TURNSTILE_SITE_KEY=your-public-site-key
VITE_DEV_LECTURE_SESSION_ID=
# Phase 1 is expand-first. Keep false until its migration has passed production checks.
VITE_PHASE1_SYNC_PROTOCOL=false
# Phase 2 archive/lifecycle UX is expand-first and remains OFF through Phase 6.
VITE_PHASE2_LECTURE_LIFECYCLE=false
# Phase 3 private PDF delivery remains OFF until Worker/R2/Edge rollout passes.
VITE_PHASE3_PRIVATE_PDF=false
# Phase 4 billing gate and Realtime captions remain OFF until the Phase 6 rollout.
VITE_PHASE4_REALTIME_CAPTIONS=false
# Phase 5 PDF analysis and AI Poll drafts remain OFF until the Phase 6 rollout.
VITE_PHASE5_MATERIAL_ANALYSIS=false
VITE_PDF_PUBLISHER_URL=http://127.0.0.1:43123
VITE_PDF_WORKER_BASE_URL=

# Future server-side / Supabase Edge Function only.
# Never expose this as VITE_OPENAI_API_KEY.
OPENAI_API_KEY=
# Must be different from ADMIN_PIN. Keep it server-side and out of browser storage.
BILLING_PIN=
PHASE4_REALTIME_CAPTIONS_ENABLED=false
PHASE5_MATERIAL_ANALYSIS_ENABLED=false
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
# $0.017 per audio minute = 17,000 micro-USD as of 2026-07-15.
OPENAI_REALTIME_PRICE_MICROUSD_PER_MINUTE=17000
