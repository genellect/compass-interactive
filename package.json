{
  "name": "compass-interactive",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/create-route-entrypoints.mjs",
    "lint": "oxlint",
    "test:demo": "node --experimental-strip-types scripts/test-demo-repository.mjs",
    "test:live-state": "node --experimental-strip-types scripts/test-live-state.mjs",
    "test:phase1-load": "node scripts/test-phase1-load.mjs",
    "test:phase2-lifecycle": "node --experimental-strip-types scripts/test-phase2-lifecycle.mjs",
    "test:phase2-load": "node scripts/test-phase2-load.mjs",
    "test:phase3-publisher": "node --experimental-strip-types publisher/tests/publisher.test.ts",
    "test:phase3-worker": "node --experimental-strip-types cloudflare/asset-worker/tests/worker.test.ts",
    "test:phase3-static": "node scripts/test-phase3-static.mjs",
    "test:phase3-load": "node scripts/test-phase3-load.mjs",
    "test:phase4-caption": "node --experimental-strip-types scripts/test-phase4-caption.mjs",
    "test:phase4-edge": "node --experimental-strip-types scripts/test-phase4-edge.mjs",
    "test:phase4-static": "node scripts/test-phase4-static.mjs",
    "test:phase4-load": "node scripts/test-phase4-load.mjs",
    "test:phase4-1-static": "node scripts/test-phase4-1-static.mjs",
    "test:phase4-1-concurrency": "node scripts/test-phase4-1-concurrency.mjs",
    "test:phase4-1-load": "node scripts/test-phase4-1-load.mjs",
    "test:phase5-edge": "node --experimental-strip-types scripts/test-phase5-edge.ts",
    "test:phase5-static": "node scripts/test-phase5-static.mjs",
    "test:phase5-load": "node scripts/test-phase5-load.mjs",
    "test:phase5-openai-live": "node --experimental-strip-types scripts/test-phase5-openai-live.ts",
    "test:phase6-edge": "node --experimental-strip-types scripts/test-phase6-edge.ts",
    "test:phase6-static": "node scripts/test-phase6-static.mjs",
    "test:phase6-load": "node scripts/test-phase6-load.mjs",
    "test:phase6-openai-live": "node --experimental-strip-types scripts/test-phase6-openai-live.ts",
    "test:phase6-5-nicknames": "node --experimental-strip-types scripts/test-phase6-5-nicknames.ts",
    "test:phase6-5-static": "node scripts/test-phase6-5-static.mjs",
    "test:phase6-5-load": "node scripts/test-phase6-5-load.mjs",
    "test:phase6-6-archive-edge": "node --experimental-strip-types scripts/test-phase6-6-archive-edge.ts",
    "test:phase6-6-archive-session": "node --experimental-strip-types scripts/test-phase6-6-archive-session.ts",
    "test:phase6-6-digest": "node --experimental-strip-types scripts/test-phase6-6-digest.ts",
    "test:phase6-6-static": "node scripts/test-phase6-6-static.mjs && node --experimental-strip-types scripts/test-phase6-6-operator-edge.ts",
    "test:phase6-6-operator-edge": "node --experimental-strip-types scripts/test-phase6-6-operator-edge.ts",
    "test:phase6-6-load": "node scripts/test-phase6-6-load.mjs",
    "test:phase6-7-docs": "node scripts/test-phase6-7-docs.mjs",
    "test:production-gate:static": "node --experimental-strip-types scripts/test-production-gate-static.mjs",
    "test:production-env": "node scripts/test-production-env.mjs",
    "test:production-local-edge": "node scripts/test-production-local-edge.mjs",
    "test:ci:nonlive": "node scripts/ci/run-nonlive-suite.mjs",
    "test:e2e:demo": "node scripts/ci/run-browser-e2e.mjs demo",
    "test:e2e:demo:direct": "playwright test --config playwright.config.ts",
    "test:e2e:local": "node scripts/ci/run-browser-e2e.mjs local",
    "test:e2e:local:direct": "playwright test --config playwright.local.config.ts",
    "test:admin-lifecycle": "node --experimental-strip-types scripts/test-admin-lifecycle.mjs",
    "test:pdf-sync": "node scripts/test-pdf-sync.mjs",
    "test:supabase:static": "node scripts/test-supabase-baseline.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:phase3": "tsc -p tsconfig.phase3.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "publisher:start": "node --experimental-strip-types publisher/src/start.ts",
    "worker:dev:local": "wrangler dev --config cloudflare/asset-worker/wrangler.jsonc --local",
    "preview": "vite preview",
    "production:check": "node scripts/check-production-env.mjs",
    "deploy:cloudflare:direct": "npm run production:check && npm run build && wrangler pages deploy dist --project-name compass-interactive --branch main",
    "worker:deploy:production:dry-run": "wrangler deploy --dry-run --config cloudflare/asset-worker/wrangler.production.jsonc",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1083.0",
    "@supabase/supabase-js": "^2.110.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.4",
    "supabase": "2.109.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wrangler": "4.110.0"
  }
}
